# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server-Side Portal Authentication Secrets (NEVER prefix with VITE_)
# Configure these in AI Studio Secrets or hosting provider environment variables
COACH_PASSCODE="SET_COACH_PASSCODE_IN_SECRETS"
EXAMINER_PASSCODE="SET_EXAMINER_PASSCODE_IN_SECRETS"
SESSION_SECRET="SET_RANDOM_HEX_SECRET_IN_SECRETS"
